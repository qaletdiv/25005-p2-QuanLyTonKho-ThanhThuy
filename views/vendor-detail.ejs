<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chi tiết Nhà cung cấp</title>
    <link rel="stylesheet" href="/assets/css/product-detail.css">
    <link rel="icon" type="image/x-icon" href="/assets/img/logo.png">
</head>
<body>
    <%- include('partials/topbar',{user:user}) %>

    <div class="container">
        <h1>Chi tiết Nhà cung cấp</h1>

        <input type="hidden" id="vendor-id">
        <div class="form-group">
            <label for="vendor-name">Tên nhà cung cấp <span style="color:red">*</span></label>
            <input type="text" id="vendor-name" placeholder="Nhập tên nhà cung cấp">
        </div>
        <div class="form-group">
            <label for="vendor-address">Địa chỉ</label>
            <input type="text" id="vendor-address" placeholder="Nhập địa chỉ">
        </div>

        <button id="saveBtn">Lưu</button>
        <button id="backBtn">Hủy</button>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="/assets/js/vendor-detail.js"></script>
</body>
</html>
